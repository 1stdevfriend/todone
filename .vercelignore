# Only the web app, the server and the sdk they build from are deployed (two Vercel projects, one per root).
/*
!/sdk
/sdk/node_modules
!/server
/server/node_modules
/server/.pglite
/server/.env*
!/clients
/clients/*
!/clients/apps
/clients/apps/*
!/clients/apps/web
/clients/apps/web/node_modules
/clients/apps/web/.next
/clients/apps/web/.env*
